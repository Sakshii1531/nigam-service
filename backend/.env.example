# Server
NODE_ENV=development
PORT=4000

# Database
# Local dev default (matches the mongod already running via `brew services`).
# Swap to a MongoDB Atlas SRV string for staging/prod — replica-set transactions
# (wallet/payment writes in Phase 5) require a replica set, which Atlas gives by default.
MONGODB_URI=mongodb://127.0.0.1:27017/nigam_care

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# File storage — Cloudinary (user-confirmed choice). Leave blank for local dev
# (falls back to writing into backend/uploads/, served at /uploads/*); required
# in production — the server refuses uploads instead of silently using local
# disk, which doesn't survive a container restart on most hosts.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=nigam-care

# OTP / SMS provider — set to `smsindiahub` once the values below are filled in
# (stub logs the code to the console instead of sending a real SMS; `test` is
# reserved for the e2e suite, see playwright.config.js). SMSINDIAHUB_OTP_TEMPLATE
# MUST match the DLT-registered template text byte-for-byte (only the {code}
# placeholder varies) or the carrier silently drops the message.
OTP_PROVIDER=stub
# A fixed code that always verifies, for demo/staging deployments with no SMS
# vendor. Outside production this defaults to 123456 so local work and the e2e
# suite keep running; in production it is off unless set here, because the stub
# provider only writes real codes to the server log and would otherwise leave a
# hosted deployment with no way to complete a login at all.
MOCK_OTP_CODE=
SMSINDIAHUB_BASE_URL=https://cloud.smsindiahub.in/api/mt/SendSMS
SMSINDIAHUB_USERNAME=
SMSINDIAHUB_PASSWORD=
SMSINDIAHUB_SENDER_ID=
SMSINDIAHUB_ENTITY_ID=
SMSINDIAHUB_DLT_TEMPLATE_ID=
SMSINDIAHUB_OTP_TEMPLATE=Your Nigam Care OTP is {code}. Valid for 10 minutes. Do not share this code with anyone.
SMSINDIAHUB_CHANNEL=2

# Payments — Razorpay (user-confirmed choice, full Checkout.js flow — see
# backend/docs/DATA_MODEL.md's Post-Phase-15 addendum). Leave blank for local
# dev/test (falls back to a locally-signed stub order so the create->verify
# round trip is still testable without real credentials); required in
# production, same fail-fast precedent as the other providers above.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# FCM — Firebase Cloud Messaging (push notifications).
# Full setup walkthrough: backend/docs/PUSH_SETUP.md — or run `npm run push:doctor`,
# which names whichever step is wrong instead of failing silently.
# Paste the entire service-account JSON as a single-line string.
FCM_SERVICE_ACCOUNT_JSON=

# Twilio — WhatsApp Business API + Voice Click-to-Call relay
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Twilio Voice: purchase a phone number in Twilio Console with Voice capability enabled.
# Both call legs (customer + technician) go through this virtual proxy number.
# Leave blank to gracefully degrade \u2014 POST /calls/initiate will return 503 until set.
TWILIO_VOICE_NUMBER=
CALL_MASKING_ENABLED=true

# Notification channel feature flags (set to 'false' to disable without removing creds)
NOTIFICATION_PUSH_ENABLED=true
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_WHATSAPP_ENABLED=true

# Technician AI assistant (POST /api/v1/tech/assistant). Leave blank to disable —
# the endpoint then returns 503 rather than answering, because the assistant is
# grounded in the technician's real job and van stock and must never invent stock
# levels, prices or warranty dates a technician would act on.
ANTHROPIC_API_KEY=

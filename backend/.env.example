# Server
NODE_ENV=development
PORT=4000

# Database
# Local dev default (matches the mongod already running via `brew services`).
# Swap to a MongoDB Atlas SRV string for staging/prod — replica-set transactions
# (wallet/payment writes in Phase 5) require a replica set, which Atlas gives by default.
MONGODB_URI=mongodb://127.0.0.1:27017/nigam_care

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# File storage (Phase 2 — Cloudflare R2 / S3-compatible; leave blank until configured)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# OTP / SMS provider (Phase 3 — stubbed until a provider is chosen)
OTP_PROVIDER=stub

# Payments (Phase 5 — Razorpay assumed, confirm before go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

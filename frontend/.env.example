# Phase 13 — real backend integration. Points the customer-facing app at a
# running backend/ instance. Copy to .env for local dev (already gitignored).
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Firebase Cloud Messaging (web push) ──────────────────────────────────────
# From Firebase console -> Project settings -> General -> "Your apps" (Web app).
# These are public by design and ship in the client bundle; the VAPID key below
# and the project's authorised-domains list are what actually gate sending.
#
# Leave blank to disable push entirely: pushClient.js feature-detects on these,
# so the app falls back to the Socket.IO feed and the REST inbox with no errors.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Project settings -> Cloud Messaging -> Web Push certificates -> "Key pair".
# Required for getToken() — without it no device token is ever issued.
VITE_FIREBASE_VAPID_KEY=
